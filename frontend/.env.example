# Browser API origin (no trailing slash).
# Local Express: http://localhost:5000
# Fullstack/public web (same-origin /api rewrite): https://web--mollure-backend--sc4tt92szkkg.code.run
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional: Express origin for Next rewrites of /api and /uploads (fullstack container).
# INTERNAL_API_ORIGIN=http://127.0.0.1:5000

# Google Sign-In (OAuth 2.0 Web client ID — must match backend GOOGLE_CLIENT_ID)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Apple Sign-In (Services ID for web — must match backend APPLE_CLIENT_ID)
# NEXT_PUBLIC_APPLE_CLIENT_ID=com.yourcompany.mollure.web

# Stripe (client prepayment + checkout). Use test keys from https://dashboard.stripe.com/test/apikeys
# For local dev, prefer frontend/.env.local (gitignored) with real keys; placeholders below:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy_mollure_local_dev_replace_me
# STRIPE_SECRET_KEY=sk_test_dummy_mollure_local_dev_replace_me
