# Live backend (default in liveApiBaseUrl.ts if unset)
NEXT_PUBLIC_API_BASE_URL=https://mollure-frontend-backend.vercel.app

# Local API only — use in .env.local for offline backend
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Stripe (copy to .env.local; never commit real keys)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
