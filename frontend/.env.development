# Local Express API (signup + verify fetch). Email deep-links use backend FRONTEND_URL (live web).
# Prefer 127.0.0.1 over localhost: Express listens on IPv4 only; Windows localhost → ::1 first.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# Stripe (and other secrets): put real test keys in frontend/.env.local (gitignored).
# See frontend/.env.example
