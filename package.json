{
  "name": "mollure-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:frontend:clean": "npm --workspace frontend run dev:clean",
    "dev:backend": "npm --workspace backend run dev",
    "dev": "npm run dev:all",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:frontend-only": "npm run dev:frontend",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:frontend": "npm --workspace frontend run start",
    "start:backend": "npm --workspace backend run start",
    "start": "npm run start:frontend",
    "lint:frontend": "npm --workspace frontend run lint",
    "lint": "npm run lint:frontend"
  },
  "engines": {
    "node": "^18.18.0 || ^20.0.0 || ^22.0.0",
    "npm": ">=9"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "overrides": {
    "qs": "6.16.0",
    "glob": "10.5.0",
    "postcss": "8.5.28"
  }
}
